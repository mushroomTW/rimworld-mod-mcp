<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      只支援 RimWorld 1.7：遊戲改跑在 .NET 10 上，Mod 組件以 net10.0 為目標。
      MCP server 本身也是 net10.0，兩者在同一個 solution 裡並存。
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>RimWorldModMcp.Bridge</AssemblyName>
    <RootNamespace>RimWorldModMcp.Bridge</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      優先參考本機安裝遊戲目錄之組件；run_test_cycle 就地建置時會以 RIMWORLD_MANAGED_DIR 注入，
      手動建置亦可透過環境變數或 -p:RimWorldManagedDir 指定。
      若本機找不到遊戲組件（如無安裝遊戲的環境或 CI），則退回使用官方套件（Krafs.Rimworld.Ref）。
    -->
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">$(RIMWORLD_MANAGED_DIR)</RimWorldManagedDir>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' and Exists('C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Assembly-CSharp.dll')">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldManagedDir>
    <HasLocalRimWorld Condition="'$(RimWorldManagedDir)' != '' and Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll') and Exists('$(RimWorldManagedDir)\UnityStubs.dll')">true</HasLocalRimWorld>
    <HasLocalRimWorld Condition="'$(HasLocalRimWorld)' == ''">false</HasLocalRimWorld>
  </PropertyGroup>

  <!-- 優先參考本機遊戲組件 -->
  <ItemGroup Condition="'$(HasLocalRimWorld)' == 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldManagedDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 找不到時改用官方套件 -->
  <ItemGroup Condition="'$(HasLocalRimWorld)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4998-unstable" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
  </ItemGroup>

</Project>
