<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      只支援 RimWorld 1.7：遊戲改跑在 .NET 10 上，Mod 組件以 net10.0 為目標。
      MCP server 本身也是 net10.0，兩者在同一個 solution 裡並存。
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>RimWorldModMcp.Bridge</AssemblyName>
    <RootNamespace>RimWorldModMcp.Bridge</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      一律參考本機安裝的遊戲組件，由 run_test_cycle 就地建置時以 RIMWORLD_MANAGED_DIR 注入。
      1.7 的 Assembly-CSharp.dll 與 UnityStubs.dll（提供 UnityEngine 型別）都在安裝根目錄。
      不使用 NuGet 的公開參考組件（Krafs.Rimworld.Ref）：它沒有 1.7 版。
    -->
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">$(RIMWORLD_MANAGED_DIR)</RimWorldManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldManagedDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <!-- 沒有遊戲組件就編不出來；明講原因，免得只看到一串找不到 Verse 型別的編譯錯誤。 -->
  <Target Name="RequireRimWorldManagedDir" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll') or !Exists('$(RimWorldManagedDir)\UnityStubs.dll')">
    <Error Text="Bridge 需要本機 RimWorld 1.7 的遊戲組件：請把 RIMWORLD_MANAGED_DIR 設為 RimWorld 1.7 的安裝根目錄（需含 Assembly-CSharp.dll 與 UnityStubs.dll）。目前的值：'$(RimWorldManagedDir)'" />
  </Target>

</Project>
