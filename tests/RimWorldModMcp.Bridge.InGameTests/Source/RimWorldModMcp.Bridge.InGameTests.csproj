<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bridge 的遊戲內整合測試（SmashPhil DevTools）。只供開發使用：不在 .slnx 裡、不隨工具發佈，
    也刻意放在 bridge/ 之外——Server 會把 bridge/** 整個內嵌進執行檔。
    Bridge 的型別幾乎都是 internal，測試一律以反射與 Harmony probe 存取，因此不參考 Bridge DLL，
    建置測試也不會重建 Bridge。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RimWorldModMcp.Bridge.InGameTests</AssemblyName>
    <RootNamespace>RimWorldModMcp.Bridge.InGameTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputPath>..\Mod\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.*-*" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.3" />
    <ProjectReference Include="..\Third-Party\DevTools\DevTools\DevTools.csproj">
      <SetProperties>ModDir=$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Mod\'))</SetProperties>
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
