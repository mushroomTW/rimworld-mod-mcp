<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="RimWorldModMcp.Tests.Assert" Alias="Assert" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RimWorldModMcp.Core\RimWorldModMcp.Core.csproj" />
  </ItemGroup>

  <!--
    以原始碼層級連結 Bridge 的 payload 產生器，而不是參考它的組件。
    Bridge 會被部署進 RimWorld 的 Assemblies 目錄，
    多一顆 DLL 就多一條與其他 Mod 組件衝突的路徑；連結原始碼則零額外相依。
  -->
  <ItemGroup>
    <Compile Include="..\..\bridge\Source\DiagnosticPayload.cs" Link="DiagnosticPayload.cs" />
    <Compile Include="..\..\bridge\Source\GameStatePayload.cs" Link="GameStatePayload.cs" />
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
