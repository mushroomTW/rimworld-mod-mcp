<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="RimWorldModMcp.Tests.Assert" Alias="Assert" />
  </ItemGroup>

  <!-- EmbeddedBridgeTests 用：模擬 Server 內嵌 Bridge 的資源命名（bridge/<相對路徑>）。 -->
  <ItemGroup>
    <EmbeddedResource Include="EmbeddedBridgeFixture\**\*" LogicalName="bridge/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RimWorldModMcp.Diagnostics\RimWorldModMcp.Diagnostics.csproj" />
  </ItemGroup>

  <!-- 與 PlatformContracts 共用的測試用程序啟動器，見 tests/Shared。 -->
  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>