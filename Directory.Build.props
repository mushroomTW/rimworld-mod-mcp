<Project>

  <!--
    整個 repo 共用的建置設定。
    注意：bridge/Source 會覆寫 ImplicitUsings。run_test_cycle 把 Bridge 複製到快取目錄再建置，
    那裡不會套用這個檔案；這裡的設定只影響 repo 內的建置。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
