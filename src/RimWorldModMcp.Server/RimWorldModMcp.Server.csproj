<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RimWorldModMcp.Server</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rimworld-mod-mcp</ToolCommandName>
    <PackageId>RimWorldModMcp</PackageId>
    <Version>0.3.0</Version>
    <Authors>mushroomTW</Authors>
    <Description>本機執行的 RimWorld Mod 開發 MCP server：索引遊戲的 Def 與 C# API、建置 Mod、在隔離環境測試。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>rimworld;mcp;modding;model-context-protocol</PackageTags>
    <!-- 標記為官方 MCP Server 套件類型 -->
    <PackageType>McpServer</PackageType>
    <!-- 只裝了較新 runtime 的機器也要能執行。 -->
    <RollForward>latestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimWorldModMcp.Core\RimWorldModMcp.Core.csproj" />
    <ProjectReference Include="..\RimWorldModMcp.Diagnostics\RimWorldModMcp.Diagnostics.csproj" />
    <ProjectReference Include="..\RimWorldModMcp.Indexing\RimWorldModMcp.Indexing.csproj" />
    <InternalsVisibleTo Include="RimWorldModMcp.Server.Tests" />
  </ItemGroup>

  <!--
    Bridge 以原始碼（bridge/About/、bridge/Source/）隨工具發佈，run_test_cycle 時參考使用者本機的
    遊戲組件就地建置。目前不再預編譯：NuGet 的公開參考組件（Krafs.Rimworld.Ref）沒有 1.7 版。
    BridgeBuilder 仍保留使用 bridge/Prebuilt/ 的執行期分支，日後恢復預編譯時可直接接回。
    原始碼以 bridge/<相對路徑> 內嵌進組件：Release 只發佈單一執行檔，旁邊沒有 bridge/ 目錄，
    執行期由 EmbeddedBridge 解到快取目錄。
  -->
  <ItemGroup>
    <!-- 複製到輸出目錄即可：dotnet tool 打包時會把整個輸出目錄收進 tools/<tfm>/any/。 -->
    <None Include="..\..\bridge\**\*" Exclude="..\..\bridge\**\bin\**;..\..\bridge\**\obj\**;..\..\bridge\Assemblies\**;..\..\bridge\Prebuilt\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>bridge\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <EmbeddedResource Include="..\..\bridge\**\*" Exclude="..\..\bridge\**\bin\**;..\..\bridge\**\obj\**;..\..\bridge\Assemblies\**;..\..\bridge\Prebuilt\**" LogicalName="bridge/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
